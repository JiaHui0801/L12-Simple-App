<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>View Expenses</title>
</head>
<body>

    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Expense List</h1>

        <a href="/addExpense" class="btn btn-primary mb-3">Add Another Expense</a>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Expense Name</th>
                    <th>Amount</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <% expenses.forEach((expense, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= expense.name %></td>
                        <td>$<%= expense.amount %></td>
                        <td><%= expense.category %></td>
                        <td><%= expense.date %></td>
                        <td>
                            <a href="/editExpense/<%= expense.id %>" class="btn btn-warning btn-sm">Edit</a>
                            <a href="/deleteExpense/<%= expense.id %>" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>